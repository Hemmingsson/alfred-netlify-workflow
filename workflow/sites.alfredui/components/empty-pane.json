{
  "id": "emptyPane",
  "type": "view",
  "layout": "border",
  "padding": 48,
  "hidden": true,
  "components": [
    {
      "constraints": {
        "region": "centre",
        "position": "centre"
      },
      "type": "view",
      "layout": "inline",
      "direction": "vertical",
      "spacing": 14,
      "components": [
        {
          "constraints": {
            "size": {
              "width": 620
            }
          },
          "id": "emptyTitle",
          "type": "label",
          "textalign": "centre",
          "linebreak": "wordwrap",
          "colour": {
            "light": "#1d1d1f",
            "dark": "#f5f5f7"
          },
          "font": {
            "size": 24,
            "weight": "semibold"
          }
        },
        {
          "constraints": {
            "size": {
              "width": 620
            }
          },
          "id": "emptyDetail",
          "type": "label",
          "textalign": "centre",
          "linebreak": "wordwrap",
          "selectable": true,
          "colour": {
            "light": "#1d1d1f",
            "dark": "#f5f5f7"
          },
          "font": {
            "size": 18
          }
        },
        {
          "constraints": {
            "insets": {
              "top": 10
            },
            "size": {
              "width": 240,
              "height": 46
            },
            "position": "centre"
          },
          "id": "emptyActionBox",
          "type": "view",
          "layout": "stack",
          "cornerradius": 10,
          "background": {
            "light": "#6b3fd4",
            "dark": "#7a50e6"
          },
          "components": [
            {
              "id": "emptyActionButton",
              "type": "button",
              "bordered": false,
              "text": "Sign in to Netlify",
              "contenttintcolour": "#ffffff",
              "font": {
                "size": 17,
                "weight": "semibold"
              },
              "events": [
                {
                  "triggers": "actioned",
                  "action": {
                    "type": "script",
                    "src": "scripts/ui",
                    "args": [
                      "{var:emptyAction}"
                    ]
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "connectingButtons",
          "type": "view",
          "layout": "inline",
          "direction": "horizontal",
          "spacing": 12,
          "hidden": true,
          "constraints": {
            "insets": {
              "top": 10
            },
            "position": "centre"
          },
          "components": [
            {
              "id": "tryAgainButton",
              "type": "button",
              "text": "Try again",
              "tooltip": "Start over with a new sign-in page",
              "font": {
                "size": 15
              },
              "events": [
                {
                  "triggers": "actioned",
                  "action": {
                    "type": "script",
                    "src": "scripts/ui",
                    "args": [
                      "sign-in"
                    ]
                  }
                }
              ]
            },
            {
              "id": "cancelSignInButton",
              "type": "button",
              "text": "Cancel",
              "tooltip": "Stop waiting for the browser",
              "font": {
                "size": 15
              },
              "events": [
                {
                  "triggers": "actioned",
                  "action": {
                    "type": "script",
                    "src": "scripts/ui",
                    "args": [
                      "cancel-sign-in"
                    ]
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
